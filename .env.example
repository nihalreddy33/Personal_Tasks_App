# Copy this file to .env.local and fill in real values. NEVER commit real secrets.

# Prisma Postgres connection string from the Vercel → Storage tab
# (looks like: prisma+postgres://accelerate.prisma-data.net/?api_key=...)
DATABASE_URL="prisma+postgres://accelerate.prisma-data.net/?api_key=YOUR_KEY"

# Shared secret that gates the API. Pick a long random string.
# The app asks for this on the lock screen; the server checks it on every request.
APP_SECRET="change-me-to-a-long-random-string"
